
@model RaceDay.Contracts.CreateCategoryRequest

@{
    ViewData["Title"] = "Create Category";
    var eventId = (int)ViewBag.EventId;
}

<h2>Create Event Category</h2>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}

<form asp-action="CreateCategory"
      asp-route-eventId="@eventId"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="eventId" value="@eventId" />

    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label">
            Category Name
        </label>
        <input asp-for="CategoryName" class="form-control" />
        <span asp-validation-for="CategoryName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryType" class="form-label">
            Category Type
        </label>
        <select asp-for="CategoryType" class="form-select">
            <option value="">-- Select Category Type --</option>
            <option value="Age">Age</option>
            <option value="Distance">Distance</option>
        </select>
        <span asp-validation-for="CategoryType"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MinAge" class="form-label">
            Minimum Age (Age categories only)
        </label>
        <input asp-for="MinAge" type="number"
               class="form-control" min="1" />
    </div>

    <div class="mb-3">
        <label asp-for="MaxAge" class="form-label">
            Maximum Age (Age categories only)
        </label>
        <input asp-for="MaxAge" type="number"
               class="form-control" min="1" />
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label">
            Distance in kilometres (Distance categories only)
        </label>
        <input asp-for="Distance" type="number"
               class="form-control" step="0.01" min="0.01" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Category
    </button>

    <a asp-action="Categories"
       asp-route-eventId="@eventId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
