@model RaceDay.Contracts.EventDto

@{
    ViewData["Title"] = "Event Details";

    var categories = ViewBag.Categories
        as List<RaceDay.Contracts.CategoryDto>
        ?? new List<RaceDay.Contracts.CategoryDto>();
}

<div class="container mt-4">

    <h2>@Model.EventName</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl"
             class="img-fluid rounded mb-3"
             style="max-height:300px; width:100%; object-fit:cover;"
             alt="Event banner" />
    }

    <div class="card mb-4">
        <div class="card-body">

            <h4>Event Information</h4>

            <p><strong>Description:</strong> @Model.Description</p>
            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Distance:</strong> @Model.Distance km</p>
            <p><strong>Event Type:</strong> @Model.EventType</p>

        </div>
    </div>

    <h4>Available Categories</h4>

    @if (!categories.Any())
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <form asp-controller="Participant"
              asp-action="EnterEvent"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="eventId"
                   value="@Model.EventId" />

            <div class="mb-3">

                <label class="form-label">
                    Select your category
                </label>

                <select name="categoryId"
                        class="form-select"
                        required>

                    <option value="">Choose a category</option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.CategoryId">
                            @category.CategoryName
                            (@category.CategoryType)
                        </option>
                    }

                </select>

            </div>

            <button type="submit" class="btn btn-success">
                Enter Event
            </button>

        </form>
    }

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Upcoming Events
    </a>

</div>